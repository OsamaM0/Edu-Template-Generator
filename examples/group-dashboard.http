### 4 · Everything the class answered ─────────────────────────────────────────
# Raw first — {question_id: answer} exactly as sent — with the graded reading
# beside it, and who has not answered yet.

GET {{baseUrl}}/api/pipeline/group/{{group}}/answers
X-Api-Key: {{apiKey}}

# 200 OK
# {
#   "schema": "pipeline.group-answers/1",
#   "issued": 6, "submitted": 4,
#   "pending": [ { "student": { "name": "ريم القحطاني" }, "answer_url": "…" } ],
#   "submissions": [
#     { "assignment_id": "xQbAI4ThL5UjHj89KsffVQ",
#       "student": { "id": "STU-1045", "name": "نورة الشمري" },
#       "submitted_at": "2026-08-22T04:07:36.198Z",
#       "overall": { "correct": 6, "total": 6, "percentage": 100 },
#       "answers": { "mc_1": "الشمسُ ساطعة", "tf_1": "خطأ", "cp_1": "الجوّ", "mc_2": "نور", … },
#       "questions": [
#         { "question_id": "mc_1", "question": "أي مما يلي جملة اسمية؟",
#           "goal_id": "goal_1", "goal_text": "يميّز بين الجملة الاسمية والفعلية",
#           "student_answer": "الشمسُ ساطعة", "correct_answer": "الشمسُ ساطعة",
#           "answered": true, "correct": true, "score": 1, "needs_review": false }
#       ],
#       "report_url": "…", "result_url": "…" }
#   ]
# }


### 4b · One student's answers out of the group ───────────────────────────────

GET {{baseUrl}}/api/pipeline/group/{{group}}/answers?student_id=STU-1044
X-Api-Key: {{apiKey}}


### 4c · The raw records, not the analysis ────────────────────────────────────

GET {{baseUrl}}/api/pipeline/assignments?group_id={{group}}&status=issued
X-Api-Key: {{apiKey}}

# 200 OK — { "count": 2, "assignments": [ { "status": "issued", "student": {…},
#            "group_id": "lesson-43617-oct", "answer_url": "…" } ] }


### 5 · Which groups exist ────────────────────────────────────────────────────

GET {{baseUrl}}/api/pipeline/groups
X-Api-Key: {{apiKey}}

# 200 OK
# { "count": 1,
#   "groups": [ { "group_id": "lesson-43617-oct",
#                 "group_name": "الخامس/ب — أنواع الجملة",
#                 "lessons": ["43617"], "students": 6,
#                 "issued": 6, "submitted": 4, "pending": 2, "submission_rate": 66.7,
#                 "dashboard_url": "…", "answers_url": "…" } ] }


### 6 · Close the group ───────────────────────────────────────────────────────
# Revokes every link still outstanding. Submitted work is untouched — its
# results stay readable and the dashboard keeps reporting them.

DELETE {{baseUrl}}/api/pipeline/group/{{group}}?reason=انتهى وقت الاختبار
X-Api-Key: {{apiKey}}

# 200 OK
# { "ok": true, "group_id": "lesson-43617-oct", "revoked": 2, "kept": 4,
#   "note": "Submitted sheets are untouched — their results stay readable, and the dashboard still reports them." }
