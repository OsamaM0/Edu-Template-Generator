# ============================================================================
# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp env.example .env
#   npm start                 # server/pipeline/env.mjs loads .env automatically
#   docker compose up         # compose reads the same file
#
# Generate the two secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ============================================================================

# --- server -----------------------------------------------------------------
PORT=8138
EDU_HOST=0.0.0.0
EDU_CORS_ORIGIN=*

# Host port `docker compose` publishes. Compose reads this one while parsing
# docker-compose.yml, so it also works as a plain shell variable.
EDU_PUBLIC_PORT=8138

# Request body ceiling in bytes, and the in-memory store behind POST /api/sheets.
EDU_MAX_BODY=4000000
EDU_SHEET_TTL_MIN=1440
EDU_MAX_SHEETS=500

# --- API security -----------------------------------------------------------
# Required on every /api/* request as  X-Api-Key: <value>  (or a Bearer token).
# Leave empty ONLY on a machine nobody else can reach.
EDU_API_KEY=

# --- the store ---------------------------------------------------------------
# ONE MongoDB server, TWO databases:
#
#   the generator's   questions, worksheets, summaries — the lessons.  READ ONLY
#   this one          every document generated and the answer key it carries,
#                     every link handed out and the status it is in, every
#                     answer, mark and analysis that comes back.       READ/WRITE
#
# Splitting them is what lets one Mongo user hold "read" on the lessons and
# "readWrite" here, so a bug in this code cannot damage the generator's output:
#
#   use admin
#   db.createUser({ user: "edu-app", pwd: "<generate>", roles: [
#     { role: "readWrite", db: "activities" },
#     { role: "read",      db: "ai" } ] })
#
# NO ROSTER IS STORED. Schools, teachers, classes and students belong to the
# platform that calls this one; they arrive as parameters and are kept as
# snapshots on what we issue. Collections and their indexes: docs/DATABASE.md.
EDU_STORE_DB=activities

# 0 turns writing off entirely. Pages still build and serve; nothing can be
# issued to a student or stored, which is a deliberate read-only mode.
EDU_STORE=1

# First run:
#   npm run store:check     can this connection read AND write? run this first
#   npm run store:indexes   declare the indexes (the server also does this on boot)
#   npm run store:import    pull data/assignments and data/output in, if upgrading

# --- document pipeline --------------------------------------------------
# 0 disables the extension entirely: /api/pipeline/*, /t/* and /a/* stop existing
# and the core render API is unaffected.
EDU_PIPELINE=1

# The MongoDB server. One connection serves both databases — the generator's
# lessons and this platform's own results — so there is one URI, not two. No
# default is compiled in: without this the extension reports its error and the
# rest of the server carries on. The value below is a placeholder, not a working
# connection. mongodb+srv:// is not supported.
EDU_PIPELINE_MONGO_URI=mongodb://user:password@host:27017/ai?authSource=admin
EDU_PIPELINE_DB=ai

# Where each part of a generated document is read from.
EDU_PIPELINE_COL_QUESTIONS=questions
EDU_PIPELINE_COL_WORKSHEETS=worksheets
EDU_PIPELINE_COL_SUMMARIES=summaries

# The logo stamped on every generated sheet: a URL or a root-relative path.
# EDU_PIPELINE_LOGO=/assets/img/logo.png
# EDU_PIPELINE_LOGO_WIDTH=96

# Signs /t/<key> page links. A page key is derived from the document_idx, so it
# is guessable — without this secret, every built lesson is world-readable to
# anyone who can reach the port.
EDU_PIPELINE_PAGE_SECRET=

# Signed-link lifetime in minutes. 0 = links never expire.
EDU_PIPELINE_LINK_TTL_MIN=0

# 0 = /t/<key> needs the API key as well, i.e. no shareable links at all.
EDU_PIPELINE_PUBLIC_PAGES=1

# --- debugging, and what a page is allowed to show --------------------------
# BOTH DEFAULT OFF. Absent means off, so a deployment that has never heard of
# these two is already in the production posture. Set either to 1 only on a
# machine you are debugging on.

# 1 puts the raw analysis JSON in a <details> block at the bottom of
# /api/pipeline/report/<id> and /group/<id>/dashboard, and returns the delivery
# internals on a submit. That JSON is the whole analysis — every question with
# its model answer — so on a live site it is an answer key one click away from
# anyone holding the link.
EDU_PIPELINE_DEBUG_JSON=0

# 1 lets a student see their own mark the instant they submit: the score, the
# per-goal bars and a link to the full report. 0 returns the receipt alone — the
# work is still graded, stored and delivered exactly the same, and the teacher
# still reads all of it through /api/pipeline/result/<id> and /report/<id>.
EDU_PIPELINE_STUDENT_RESULTS=0

# --- Pipeline caching ----------------------------------------------------
# Point this OUTSIDE the site root. The server serves its own directory
# statically, so a cache inside it is downloadable as plain files — which walks
# straight past the /t/<key> signature. Requests for it are refused either way,
# but the files are better off not being there at all.
# EDU_PIPELINE_CACHE_DIR=/var/lib/edu/cache

EDU_PIPELINE_CACHE_MAX=2000
EDU_PIPELINE_CACHE_TTL_MIN=0
EDU_PIPELINE_DOC_TTL_MIN=10
EDU_PIPELINE_MEM_PAGES=64

# --- Student answer sheets and results --------------------------------------
# Passing student_id to /api/pipeline/document (or /assign) issues a single-use
# link at /a/<id>?t=<token>. Submitting it kills the link and writes the graded,
# per-goal analysis. A new link only comes from a new request.

# Answer KEYS live here — one file per issued sheet. Put it OUTSIDE the site
# root: the server refuses to serve the path either way, but the correct answers
# to live sheets should not be sitting in a directory that is served statically.
# EDU_PIPELINE_ASSIGN_DIR=/var/lib/edu/assignments

# How long a student link stays open, in minutes. 0 = until it is submitted.
EDU_PIPELINE_ASSIGN_TTL_MIN=0

# Most students one POST /api/pipeline/batch (or /assign with a "students"
# array) issues in a single call. A bigger class is several calls with the same
# group_id — they land in the same group.
EDU_PIPELINE_ROSTER_LIMIT=200

# Submitted results: <assignment>.json (the analysis) and <assignment>.html
# (the per-student report page). Also outside the site root, for the same reason.
# EDU_PIPELINE_OUTPUT_DIR=/var/lib/edu/output

# 0 stops writing result files / 0 stops printing them to stdout. With no backend
# configured these two ARE the delivery, so turning both off discards the result.
EDU_PIPELINE_SAVE_RESULTS=1
EDU_PIPELINE_PRINT_RESULTS=1

# --- Reporting to your backend ----------------------------------------------
# Leave empty and results are only saved and logged; the submission still
# succeeds. Set either or both and each submission is POSTed as JSON:
#   SUBMIT   { assignment_id, student_id, answers: {question_id: answer}, … }
#   ANALYSIS the full analysis: per-goal percentages, the report, every question
# A backend that is down or slow is reported in the submit response and never
# fails the student's submission — the result is on disk and can be replayed.
# EDU_PIPELINE_SUBMIT_ENDPOINT=https://lms.example.com/api/worksheet-submissions
# EDU_PIPELINE_ANALYSIS_ENDPOINT=https://lms.example.com/api/worksheet-analysis
# EDU_PIPELINE_BACKEND_TOKEN=
# EDU_PIPELINE_BACKEND_HEADER=Authorization
EDU_PIPELINE_BACKEND_TIMEOUT_MS=8000

# --- Where this file lives --------------------------------------------------
# .env must NOT sit in the served site root. The server refuses to serve
# dotfiles, but keep the file outside the root and point at it instead:
#
#   EDU_ENV_FILE=/home/you/config/edu.env npm start
#
# This one is read BEFORE the file is loaded, so it has to come from the real
# environment — setting it inside .env does nothing.
